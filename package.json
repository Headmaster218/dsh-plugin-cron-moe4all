  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-plugin-cron-moe4all.git"
  },
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-plugin-cron-moe4all/issues"
  },
  "homepage": "https://github.com/Headmaster218/dsh-plugin-cron-moe4all#readme",
  "moe4all": {
    "upstream": "dsh-plugin-cron-scheduler@0.2.7",
