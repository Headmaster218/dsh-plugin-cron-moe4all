{
  "name": "dsh-plugin-cron-moe4all",
  "description": "MoE4All edition of the Cron scheduler plugin for DeepSeek Harness",
  "version": "0.2.7-moe4all.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "types/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
